<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.example.kpitable" extension-version="0.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Custom-styled KPI table for Tableau worksheets.</description>
    <author name="KPI Table Prototype"
            email="developer@example.com"
            organization="Prototype"
            website="https://example.com"/>
    <min-api-version>1.1</min-api-version>
    <source-location>
      <url>http://localhost:8765/KpiTable.html</url>
    </source-location>
    <icon/>
  </worksheet-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">KPI Table Prototype</text>
    </resource>
  </resources>
</manifest>
